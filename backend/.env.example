# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/rentx

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=30d

# Twilio (SMS OTP) - Sign up at twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Cloudinary (Image Storage) - Sign up at cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firebase Admin SDK (Push Notifications)
# Download serviceAccountKey.json from Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Google Sign-In (Web client ID from Google Cloud Console > APIs & Services > Credentials)
# Must match the Web client ID used as GOOGLE_WEB_CLIENT_ID in mobile/src/utils/googleAuth.ts
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# OTP Settings
OTP_EXPIRY_MINUTES=10

# App
CLIENT_URL=http://localhost:3000
